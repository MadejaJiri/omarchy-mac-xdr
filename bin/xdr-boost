#!/bin/bash
# Drive the built-in panel's backlight above the driver's 504-nit maximum.
# Needs the probe: bin/xdr-probe load
#
#   xdr-boost on            1000 nits (XDR_BOOST_DEFAULT)
#   xdr-boost off           back to the brightness keys
#   xdr-boost toggle
#   xdr-boost set <nits>    505..1000; up to 1600 with XDR_BOOST_UNSAFE=1
#   xdr-boost up | down     step by 100 nits; down past 600 turns it off
#   xdr-boost status
#
# While on, the brightness keys have no effect.
#
# Apple holds this panel to 1000 nits sustained full-screen and 1600 only for
# highlights, and under Linux the firmware gets no real panel temperature.
# Hence the 1000 limit here.
set -euo pipefail

params=/sys/module/apple_xdr_probe/parameters
default=${XDR_BOOST_DEFAULT:-1000}
limit=1000; [[ ${XDR_BOOST_UNSAFE:-0} == 1 ]] && limit=1600

[[ -d $params ]] || { echo "xdr-boost: probe not loaded (bin/xdr-probe load)" >&2; exit 1; }

# The request is a 4.28 float: nits = 2^(e+1) * (1 + f).
encode() { python3 -c "
import math, sys
n = float(sys.argv[1]); e = int(math.floor(math.log2(n))) - 1
print('0x%08x' % ((e << 28) | int((n / 2 ** (e + 1) - 1) * 2 ** 28)))" "$1"; }
decode() { python3 -c "
import sys
v = int(sys.argv[1]); print(round(2 ** ((v >> 28) + 1) * (1 + (v & 0xfffffff) / 2 ** 28)) if v else 0)" "$1"; }

current() { if grep -q 'armed=1' $params/status; then decode "$(cat $params/bl_raw)"; else echo 0; fi; }
note() { command -v notify-send >/dev/null && notify-send -t 1500 "XDR boost" "$1" || true; echo "$1"; }

set_nits() {
  local n=$1
  [[ $n =~ ^[0-9]+$ ]] && (( n >= 505 && n <= limit )) || { echo "xdr-boost: nits must be 505..$limit" >&2; exit 1; }
  printf 0 > $params/hold_ms
  printf '%s' "$(encode "$n")" > $params/bl_raw
  note "$n nits"
}

off() {
  echo 1 > $params/reset
  printf 20000 > $params/hold_ms
  note "off"
}

case ${1:-status} in
  on) set_nits "$default" ;;
  off) off ;;
  toggle) if (( $(current) )); then off; else set_nits "$default"; fi ;;
  set) set_nits "${2:?nits}" ;;
  up) c=$(current); (( c )) || c=500; n=$(( c + 100 )); (( n > limit )) && n=$limit; set_nits $n ;;
  down) c=$(current); if (( c > 600 )); then set_nits $(( c - 100 )); elif (( c )); then off; fi ;;
  status)
    c=$(current); (( c )) && echo "on: $c nits requested" || echo "off"
    echo "firmware: $(head -1 $params/mnits)"
    ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
